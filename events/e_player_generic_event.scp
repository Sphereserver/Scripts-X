VERSION=X1

// Generic event to all players.
[events e_player_generic_event]

on=@login
    // If enabled in configuration, chatname will be changed to character name on login.
    if (<def.config.chatname_char> == 1)
        account.chatname = <src.name>
    endif

[eof]
